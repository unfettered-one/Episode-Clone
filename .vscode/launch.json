    "version": "0.2.0",
    "configurations": [
        {
            "name": "Service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "episode.main:app",
                "--reload",
                "--host",
                "0.0.0.0"
